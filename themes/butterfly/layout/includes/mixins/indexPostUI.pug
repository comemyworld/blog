mixin indexPostUI()
  #home-portfolio.home-portfolio.nc
    .home-portfolio-items
      each article, index in page.posts.data
        - const link = article.link || article.path
        - const title = article.title || _p('no_title')
        - const cover = article.cover
        - const hasCover = cover && article.cover !== false && theme.cover.index_enable
        - const desc = postDesc(article)
        - const isTop = globalPageType === 'home' && (article.top || article.sticky > 0)

        a.home-card(href=url_for(link), title=title)
          if isTop
            .home-card-pin
              i.fas.fa-thumbtack
          if hasCover
            .home-card-cover
              if article.cover_type === 'img'
                img(src=url_for(cover), onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'`, alt=title)
              else
                div(style=`background: ${cover}; width: 100%; height: 100%; background-size: cover; background-position: center;`)
          else
            .home-card-cover.home-card-no-cover
              i.fas.fa-file-lines
          .home-card-overlay
            .home-card-body
              if theme.post_meta.page.categories && article.categories.data.length > 0
                .home-card-cats
                  each item, i in article.categories.data
                    if i < 2
                      span.home-card-cat= item.name
              h3.home-card-title= title
              if desc
                .home-card-desc!= desc
              .home-card-meta
                if theme.post_meta.page.date_type
                  - const dType = theme.post_meta.page.date_type
                  if dType === 'both' || dType === 'created'
                    span.home-card-date
                      i.far.fa-calendar-alt
                      | &nbsp;
                      = date(article.date, config.date_format)
                  else if dType === 'updated'
                    span.home-card-date
                      i.fas.fa-history
                      | &nbsp;
                      = date(article.updated, config.date_format)
                if theme.post_meta.page.tags && article.tags.data.length > 0
                  .home-card-tags
                    each tag, i in article.tags.data
                      if i < 3
                        span
                          i.fas.fa-tag
                          | &nbsp;
                          = tag.name
        if theme.ad && theme.ad.index
          if (index + 1) % 3 === 0
            .recent-post-item.ads-wrap!= theme.ad.index

    include ../pagination.pug
